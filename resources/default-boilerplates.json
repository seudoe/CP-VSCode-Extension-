    "}",
    "",
    "impl Scanner {",
    "    fn new() -> Self {",
    "        let mut input = String::new();",
    "        io::stdin().read_to_string(&mut input).unwrap();",
    "        let input = input.split_whitespace()",
    "            .map(String::from)",
    "            .collect();",
    "        Self { input, index: 0 }",
    "    }",
    "",
    "    fn next<T: std::str::FromStr>(&mut self) -> T {",
    "        self.input[self.index].parse().ok().unwrap()",
    "    ",
    "    }",
    "}",
    "",
    "fn main() {",
    "    let mut sc = Scanner::new();",
    "    let t: usize = sc.next();",
    "",
    "    for _ in 0..t {",
    "        solve(&mut sc);",
