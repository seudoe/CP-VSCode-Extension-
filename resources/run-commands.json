      "dotnet": { "run": ["dotnet", "run", "--project", "{source_dir}"] }
    },
    "linux": {
      "mono": { "compile": ["mcs", "-optimize", "{source}", "-out:{binary}.exe"], "run": ["mono", "{binary}.exe"] },
