    "darwin": {
      "python3": { "run": ["python3", "{source}"] },
      "python": { "run": ["python", "{source}"] },
      "pypy3": { "run": ["pypy3", "{source}"] }
    }
  },
  "java": {
    "win32": {
      "javac": { "compile": ["javac", "-d", "{binary_dir}", "{source}"], "run": ["java", "-cp", "{binary_dir}", "Main"] }
    },
    "linux": {
      "javac": { "compile": ["javac", "-d", "{binary_dir}", "{source}"], "run": ["java", "-cp", "{binary_dir}", "Main"] }
    },
    "darwin": {
      "javac": { "compile": ["javac", "-d", "{binary_dir}", "{source}"], "run": ["java", "-cp", "{binary_dir}", "Main"] }
    }
  },
  "go": {
    "win32": {
      "go": { "compile": ["go", "build", "-o", "{binary}.exe", "{source}"], "run": ["{binary}.exe"] }
    },
    "linux": {
      "go": { "compile": ["go", "build", "-o", "{binary}", "{source}"], "run": ["{binary}"] }
    },
