{
  "cpp": {
    "win32": {
      "g++": { "compile": ["g++", "{source}", "-O2", "-Wall", "-o", "{binary}"], "run": ["{binary}.exe"] },
      "clang": { "compile": ["clang++", "{source}", "-O2", "-Wall", "-o", "{binary}.exe"], "run": ["{binary}.exe"] },
      "msvc": { "compile": ["cl", "/O2", "/EHsc", "{source}", "/Fe:{binary}.exe"], "run": ["{binary}.exe"] }
    },
    "linux": {
      "g++": { "compile": ["g++", "{source}", "-O2", "-Wall", "-o", "{binary}"], "run": ["{binary}"] },
      "clang": { "compile": ["clang++", "{source}", "-O2", "-Wall", "-o", "{binary}"], "run": ["{binary}"] }
    },
    "darwin": {
      "clang": { "compile": ["clang++", "{source}", "-O2", "-Wall", "-o", "{binary}"], "run": ["{binary}"] },
      "g++": { "compile": ["g++", "{source}", "-O2", "-Wall", "-o", "{binary}"], "run": ["{binary}"] }
    }
  },
  "c": {
    "win32": {
      "gcc": { "compile": ["gcc", "{source}", "-O2", "-Wall", "-o", "{binary}"], "run": ["{binary}.exe"] },
      "clang": { "compile": ["clang", "{source}", "-O2", "-Wall", "-o", "{binary}.exe"], "run": ["{binary}.exe"] },
      "msvc": { "compile": ["cl", "/O2", "{source}", "/Fe:{binary}.exe"], "run": ["{binary}.exe"] }
    },
    "linux": {
      "gcc": { "compile": ["gcc", "{source}", "-O2", "-Wall", "-o", "{binary}"], "run": ["{binary}"] },
      "clang": { "compile": ["clang", "{source}", "-O2", "-Wall", "-o", "{binary}"], "run": ["{binary}"] }
    },
    "darwin": {
      "clang": { "compile": ["clang", "{source}", "-O2", "-Wall", "-o", "{binary}"], "run": ["{binary}"] },
      "gcc": { "compile": ["gcc", "{source}", "-O2", "-Wall", "-o", "{binary}"], "run": ["{binary}"] }
    }
  },
  "py": {
    "win32": {
      "python": { "run": ["python", "{source}"] },
      "python3": { "run": ["python3", "{source}"] },
      "pypy": { "run": ["pypy", "{source}"] }
    },
    "linux": {
      "python3": { "run": ["python3", "{source}"] },
      "python": { "run": ["python", "{source}"] },
      "pypy3": { "run": ["pypy3", "{source}"] }
